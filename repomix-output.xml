<file path="app/globals.css">
@tailwind base;
@tailwind components;
@tailwind utilities;

/* =========================================
  PREMIUM AWWWARDS-INSPIRED ENGINE THEME 
  =========================================
*/

:root {
  /* Cinematic midnight deep background layout */
  --bg: #030303;
  --text: #a1a1aa;
  --highlight: #00ffcc; /* Kinetic Liquid Cyan Accent */
  --card-bg: #0b0b0d; /* Floating Obsidian Surfaces */
  --badge-bg: #121217;
  --hover-glow: rgba(0, 255, 204, 0.05);
  --border-color: rgba(255, 255, 255, 0.04);
  --text-contrast: #f4f4f5;

  /* --- STRUCTURE HARMONY ENGINE VARIABLES --- */
  --grid-color: rgba(255, 255, 255, 0.03);
  --dotted-frame: rgba(
    0,
    255,
    204,
    0.3
  ); /* Uses bright accent color in dark mode */
  --dotted-frame-opacity: 0.25;
  --dotted-frame-hover-opacity: 0.75;
  --tile-shadow-base: rgba(0, 0, 0, 0.6);
  --tile-shadow-hover: rgba(0, 0, 0, 0.85);

  /* Radial mouse cursor glow configuration override */
  --radial-glow: rgba(0, 255, 204, 0.12);

  /* Luxury Typographic Micro Scales */
  --font-display: "Syne", "Inter", sans-serif;
}

body.light {
  /* Gallery Studio Light Palette */
  --bg: #f9f9fb;
  --text: #4b5563;
  --highlight: #0055ff; /* Hyper-saturated Blue Accent */
  --card-bg: #ffffff;
  --badge-bg: #f3f4f6;
  --hover-glow: rgba(0, 85, 255, 0.06);
  --border-color: rgba(0, 0, 0, 0.08);
  --text-contrast: #111827;

  /* --- INTENSIFIED STRUCTURE FOR LIGHT MODE PARITY --- */
  --grid-color: rgba(0, 0, 0, 0.04);

  /* AGGRESSIVE DARK FRAMING TRACKS */
  --dotted-frame: #0055ff;
  --dotted-frame-opacity: 0.55;
  --dotted-frame-hover-opacity: 1;

  /* DEEP AGGRESSIVE BACKGROUND TILES & VOLUME DROP SHADOWS FOR LIGHT PARITY */
  --tile-shadow-base: rgba(0, 0, 0, 0.05);
  --tile-shadow-hover: rgba(0, 0, 0, 0.25);

  /* Ambient light radial hover gradient profile track (Stronger Blue for light mode visibility) */
  --radial-glow: rgba(0, 85, 255, 0.14);
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* Custom Interactive Scroll Track */
html {
  scroll-behavior: smooth;
  background-color: var(--bg);
}

body {
  font-family: "Inter", sans-serif;
  background: var(--bg);
  color: var(--text);
  line-height: 1.6;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
  transition:
    background 0.5s cubic-bezier(0.2, 0.8, 0.2, 1),
    color 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);

  /* Ambient Production Grid Overlay Matrix */
  background-image:
    linear-gradient(var(--grid-color) 1px, transparent 1px),
    linear-gradient(90deg, var(--grid-color) 1px, transparent 1px);
  background-size: 100px 100px;
  background-position: center top;
}

/* ========================================================
  OVERRIDE SELECTORS FOR GLOBAL GEOMETRIC DOTTED FRAMES
  ======================================================== */
.project-bg-geo,
div[class*="project-bg-geo"] {
  border-color: var(--dotted-frame) !important;
  opacity: var(--dotted-frame-opacity) !important;
  transition:
    opacity 0.4s ease,
    border-color 0.4s ease !important;
}

.group:hover .project-bg-geo,
*:hover > .project-bg-geo {
  border-color: var(--highlight) !important;
  opacity: var(--dotted-frame-hover-opacity) !important;
}

/* ========================================================
  MOUSE GLOW ENGINE ENGINE OVERRIDE FIX (Light Mode Visibility)
  ======================================================== */
/* Forces the card component background-glow to dynamically accept our CSS theme system tokens */
div[class*="col-span-12"]::before,
.tile::before {
  background: radial-gradient(
    400px circle at var(--mouse-x, 0px) var(--mouse-y, 0px),
    var(--radial-glow),
    transparent 80%
  ) !important;
}

/* =========================================
  HIGH-FIDELITY CODE EMBED DISPLAY SYNTAX
  =========================================
*/
body.light pre code span.keyword {
  color: #cf222e;
}
body.light pre code span.function {
  color: #953800;
}
body.light pre code span.variable {
  color: #0550ae;
}
body.light pre code span.control {
  color: #a011b2;
}

body:not(.light) pre code span.keyword {
  color: #ff7b72;
}
body:not(.light) pre code span.function {
  color: #d2a8ff;
}
body:not(.light) pre code span.variable {
  color: #79c0ff;
}
body:not(.light) pre code span.control {
  color: #ff7b72;
}

/* =========================================
  INTERACTIVE NAVIGATION & HEADER DYNAMICS
  =========================================
*/
.navbar-wrapper {
  width: 100%;
  position: sticky;
  top: 0;
  z-index: 2000;
  background: transparent;
  transition:
    backdrop-filter 0.4s ease,
    background-color 0.4s ease;
}

.navbar-wrapper.scrolled {
  backdrop-filter: blur(20px);
  background-color: rgba(3, 3, 3, 0.75);
  border-bottom: 1px solid var(--border-color);
}

body.light .navbar-wrapper.scrolled {
  background-color: rgba(249, 249, 251, 0.8);
}

nav a {
  text-decoration: none;
  color: var(--text);
  text-transform: uppercase;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.2em;
  position: relative;
  transition: color 0.3s ease;
}

nav a:hover,
nav a.active {
  color: var(--highlight);
}

nav a::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: -4px;
  width: 100%;
  height: 1px;
  background: var(--highlight);
  transform: scaleX(0);
  transform-origin: right;
  transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1);
}

nav a.active::after,
nav a:hover::after {
  transform: scaleX(1);
  transform-origin: left;
}

/* =========================================
  PREMIUM LAYOUT UTILITIES & KINETIC TILES
  =========================================
*/
h1,
h2,
h3,
.display-font {
  font-family: var(--font-display);
  font-weight: 800;
  letter-spacing: -0.04em;
  color: var(--text-contrast);
}

h1 {
  font-size: clamp(2.5rem, 7vw, 5.5rem);
  line-height: 0.95;
}

h1 span {
  color: var(--highlight);
  text-shadow: 0 0 40px rgba(0, 255, 204, 0.15);
}

/* Interactive Grid Canvas Card Components */
.tile {
  background: var(--card-bg);
  padding: 2.5rem;
  border-radius: 16px;
  border: 1px solid var(--border-color);
  position: relative;
  overflow: hidden;
  box-shadow: 0 8px 32px var(--tile-shadow-base);
  transition:
    border-color 0.4s ease,
    box-shadow 0.4s ease,
    background-color 0.4s ease,
    transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
}

/* Keep standard mouse layout matching config styles */
.tile::before {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 1;
}

.tile:hover {
  transform: translateY(-4px) scale(1.005);
  box-shadow:
    0 24px 48px var(--tile-shadow-hover),
    0 0 40px var(--hover-glow);
}

body.light .tile:hover {
  border-color: var(--highlight);
}

body:not(.light) .tile:hover {
  border-color: rgba(0, 255, 204, 0.3);
}

/* Subtle tech flag design rules */
.tech-stack span {
  display: inline-block;
  padding: 0.4rem 0.8rem;
  background: var(--badge-bg);
  color: var(--text-contrast);
  border: 1px solid var(--border-color);
  margin: 0.3rem 0.4rem 0.3rem 0;
  border-radius: 8px;
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.02em;
}

/* =========================================
  THEME SWITCHER & UTILITY INTERFACES
  =========================================
*/
.theme-toggle,
.scroll-to-top {
  width: 46px;
  height: 46px;
  background: var(--card-bg);
  border-radius: 50%;
  border: 1px solid var(--border-color);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.theme-toggle:hover {
  border-color: var(--highlight);
  box-shadow: 0 0 15px var(--hover-glow);
}

/* Smooth Premium Rendering Classes */
.fade-in {
  animation: premiumReveal 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes premiumReveal {
  from {
    opacity: 0;
    transform: translateY(30px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Core reveal animation matrix configuration */
@keyframes fadeInContent {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
